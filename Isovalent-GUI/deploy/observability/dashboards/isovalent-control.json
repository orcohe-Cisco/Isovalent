    }
  ],
  "title": "Isovalent Control \u2014 Cilium / Hubble / Tetragon",
  "uid": "isovalent-control",
  "tags": [
    "cilium",
    "hubble",
    "tetragon",
    "security"
  ],
  "timezone": "",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "DS_PROMETHEUS",
        "type": "datasource",
        "query": "prometheus",
        "current": {}
